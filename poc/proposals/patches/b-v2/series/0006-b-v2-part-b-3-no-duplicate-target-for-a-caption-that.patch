+% \changes{v1.2k}{2026/10/05}{A caption that does not step the counter
+%    gets a target with a unique name, not a duplicate of the last one}
 %    \begin{macrocode}
 \def\@caption@target#1{%
   \@ifundefined{@floatHref@#1}%
@@ -481,8 +508,22 @@
      \fi
      {#1}}}
 \def\@caption@newtarget#1{%
-  \UseSocket{refstepcounter/target}{#1}%
+  \if@captionstep
+    \expandafter\@firstoftwo
+  \else
+    \expandafter\@secondoftwo
+  \fi
+  {\UseSocket{refstepcounter/target}{#1}}%
+  {\@caption@uniquetarget{#1}}%
   \UseTaggingSocket{recordtarget}}
+\def\@caption@uniquetarget#1{%
+  \xdef\@caption@unstepped{\the\numexpr\@caption@unstepped+\@ne}%
+  \begingroup
+    \expandafter\protected@edef\csname theH#1\endcsname
+      {\csname theH#1\endcsname*\@caption@unstepped}%
+    \UseSocket{refstepcounter/target}{#1}%
+  \endgroup}
+\def\@caption@unstepped{0}
 \def\@caption@floattarget#1{%
   \xdef\@currentHref{\csname @floatHref@#1\endcsname}}
 %    \end{macrocode}
