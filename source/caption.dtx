% \begin{macro}{\DeclareCaptionLabelSeparator}
% |\DeclareCaptionLabelSeparator|\marg{name}\marg{code}
% \changes{v3.0a}{17 Jan 04}{We pass through argument no.2 so extra spaces between the arguments do make any harm}
