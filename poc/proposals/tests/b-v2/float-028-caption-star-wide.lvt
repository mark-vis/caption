% \caption* that is wider than the line, so that the \@makecaption of
% latex-lab typesets it as a paragraph and not in a box of the line width:
% the paragraph must get one P (the one of the para/begin socket), not a
% second one from the para hooks. With the plugs noop of the label tagging
% sockets the para hooks were unbalanced (tagpdf error "para hooks differ"
% at the end, which is not in the test log, so the counts are shown). A
% short \caption* and a wide numbered caption for comparison.
\DocumentMetadata{lang=en,tagging=on}
\input{regression-test}
\documentclass{article}
\begin{document}
\START
\begin{table}[h]\centering
  \caption*{A starred caption that is wider than the line, so that it is
    typeset as a paragraph and not in a box of the line width}
\end{table}
\begin{table}[h]\centering
  \caption*{Short starred}
\end{table}
\begin{table}[h]\centering
  \caption{A numbered caption that is wider than the line, so that it is
    typeset as a paragraph and not in a box of the line width}
\end{table}
\ExplSyntaxOn
\typeout{para~hooks~(text-block):~\int_use:N \g__tag_para_main_begin_int
  \space begin,~\int_use:N \g__tag_para_main_end_int \space end}
\typeout{para~hooks~(semantic):~\int_use:N \g__tag_para_begin_int
  \space begin,~\int_use:N \g__tag_para_end_int \space end}
\ExplSyntaxOff
\SHOWPDFTAGS
\end{document}
