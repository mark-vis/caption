\NeedsTeXFormat{LaTeX2e}[1994/12/01]
\ProvidesPackage{unittest}[2020/07/29 v0.1 Macros for unit-tests (AR)]
%
\newcommand*\passed[1]{%
  \typeout{Test `#1' passed.}}
\newcommand*\failed[1]{%
  \PackageError{unittest}{Test `#1' failed}{}}
%
\newcommand*\testdefined[2]{%
  \@ifundefined{#2}\failed\passed{#1}}
\newcommand*\testundefined[2]{%
  \@ifundefined{#2}\passed\failed{#1}}
%
\newcommand*\testequal[3]{%
  \begingroup
    \def\test@temp{#3}%
    \ifx#2\test@temp
      \expandafter\passed
    \else
      \expandafter\failed
    \fi
    {#1}%
  \endgroup}
%
\newcommand*\testident[3]{%
  \ifx#2#3%
    \expandafter\passed
  \else
    \expandafter\failed
  \fi
  {#1}}
%
\newcommand*\testcounter[3]{%
  \expandafter\ifnum\csname c@#2\endcsname=#3\relax
    \expandafter\passed
  \else
    \expandafter\failed
  \fi
  {#1}}
%
\endinput
