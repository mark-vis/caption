+% \begin{socketdecl}{caption/step}
+%    This socket is used by \cs{caption} (not by \cs{caption*}) to step
+%    the counter of the caption type and to set the target for links
+%    (\cs{@currentHref}). The argument is the counter name
+%    (\cs{@captype}). The default plug \plug{kernel} calls
+%    \cs{refstepcounter}. The float code of the tagging project uses the
+%    socket to set the target to the float structure instead of creating
+%    a new one.
+% \end{socketdecl}
+%
+% \begin{socketdecl}{caption/listentry}
+%    This socket writes the entry for the list of figures, tables, etc.
+%    It is used by \cs{@caption} unless the star form \cs{caption*}
+%    was used. The first argument is the caption type, the second the
+%    text for the list (the optional argument of \cs{caption}, or the
+%    caption text if it was not given). The default plug
+%    \plug{kernel} writes the entry with \cs{addcontentsline} as
+%    before; it also writes an (empty) entry if the optional argument
+%    is empty.
+%
+%    The declarations are also written to \texttt{latexrelease}, guarded,
+%    so that rolling forward from an older format works.
+%    \begin{macrocode}
+%</2ekernel>
+%<*2ekernel|latexrelease>
+%<latexrelease>\IncludeInRelease{2026/11/01}%
+%<latexrelease>                 {caption sockets}{caption interface}%
+\IfSocketExistsF{caption/step}{%
+  \NewSocket{caption/step}{1}%
+  \NewSocketPlug{caption/step}{kernel}{\refstepcounter{#1}}%
+  \AssignSocketPlug{caption/step}{kernel}%
+}
+\IfSocketExistsF{caption/listentry}{%
+  \NewSocket{caption/listentry}{2}%
+  \NewSocketPlug{caption/listentry}{kernel}
+    {%
+      \addcontentsline{\csname ext@#1\endcsname}{#1}%
+        {\protect\numberline{\csname the#1\endcsname}{\ignorespaces #2}}%
+    }%
+  \AssignSocketPlug{caption/listentry}{kernel}%
+}
+%    \end{macrocode}
+% \end{socketdecl}
+%
+% \begin{macro}{\if@captionstar}
+%    True while a caption is typeset by \cs{caption*}. Implementations
+%    of \cs{@makecaption} can test it; in that case the first argument
+%    of \cs{@makecaption} is empty. (\cs{@ifundefined} and not \cs{ifx}
+%    because a skipped \cs{if@captionstar} would unbalance the
+%    conditional.)
+%    \begin{macrocode}
+\@ifundefined{if@captionstar}{\newif\if@captionstar}{}
+%    \end{macrocode}
+% \end{macro}
+%
+%    \begin{macrocode}
+%</2ekernel|latexrelease>
+%<latexrelease>\EndIncludeInRelease
+%<*2ekernel>
+%    \end{macrocode}
+%
 % \begin{macro}{\caption}
 %
 %    This is set to be an error message outside a float since no
@@ -236,17 +297,51 @@
