+  \vshapeto{hbox (in the paragraph, warning)}%
+    {\noindent\hbox{ -- }Text}{\nolabel\hbox{ -- }\ignorespaces Text}%
+  \vshapeto{penalty (horizontal, no warning)}%
+    {\noindent\penalty 7 Text}{\nolabel\penalty 7 \ignorespaces Text}}
