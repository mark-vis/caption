% Setting up caption type: Simply execute the saved option list
% (For use inside \@caption, \LT@makecaption etc.)
%
\def\caption@settype#1{%
  \@ifundefined{caption@typ@#1}{}{%
    \caption@esetup{\csname caption@typ@#1\endcsname}}}%
