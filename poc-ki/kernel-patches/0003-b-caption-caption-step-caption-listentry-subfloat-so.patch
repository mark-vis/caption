+      {\ignorespaces #3}\par
+  \endgroup
+%    \end{macrocode}
+%    The star flag is reset, so that code which calls \cs{@caption}
+%    directly (without \cs{caption}) gets a normal caption.
+%    \begin{macrocode}
+  \@captionstarfalse}
+%</2ekernel|latexrelease>
+%<latexrelease>\EndIncludeInRelease
+%<latexrelease>\IncludeInRelease{0000/00/00}%
+%<latexrelease>                 {\@caption}{star form, list entry socket}%
+%<latexrelease>\long\def\@caption#1[#2]#3{%
+%<latexrelease>  \par
+%<latexrelease>  \addcontentsline{\csname ext@#1\endcsname}{#1}%
+%<latexrelease>    {\protect\numberline{\csname the#1\endcsname}{\ignorespaces #2}}%
+%<latexrelease>  \begingroup
+%<latexrelease>    \@parboxrestore
+%<latexrelease>    \if@minipage
