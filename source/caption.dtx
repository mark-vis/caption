% \begin{macro}{\caption@floatstruct}
% \changes{v3.7}{2026/10/04}{This macro added}
%  |\caption@floatstruct|\par
%  The parent structure of a main caption is the float (whose structure number is
%  stored by \texttt{latex-lab} in |\@current@float@struct|);
%  a sub-caption stays in the current structure (i.e.~its sub-figure).
%    \begin{macrocode}
\newcommand*\caption@floatstruct{%
  \caption@ifsubtype{}{\ifdefined\@current@float@struct\@current@float@struct\fi}}
%    \end{macrocode}
% \end{macro}
