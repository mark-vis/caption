      \def\@makecaption##1{%
        \@makecaptionex{\@nameuse{#1name}}{\@nameuse{the#1}}}%
      \caption@@orig{#1}[{#2}]{#3}%
    \endgroup}
%
% Define \caption* ...
% (07/18/03: \global added, so this works with sidecap)
%
  \@ifundefined{cc@caption}{%
    \def\caption@caption#1{%
      \@ifstar{\global\caption@startrue\@ifnextchar[{#1}{#1[]}}{#1}}%
    \let\caption@orig\caption
    \def\caption{\caption@caption\caption@orig}%
  }{%
    \let\caption@@captcont\cc@scaption
    \long\def\cc@scaption#1[#2]#3{%
      \begingroup
        \caption@settype{#1}%
%
        \def\@makecaption##1{%
          \@makecaptionex{\@nameuse{#1name}}{\@nameuse{the#1}}}%
        \caption@@captcont{#1}[{#2}]{#3}%
