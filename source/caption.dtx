% \begin{macro}{\caption@iftagfloat}
% \changes{v3.7}{2026/10/04}{This macro added}
%  |\caption@iftagfloat|\marg{true}\marg{false}\par
%  Expands to \meta{true} inside a float environment handled by \texttt{latex-lab}
%  (for main captions only), otherwise to \meta{false}.
%  Such a float has its own link target \meta{type}\texttt{.struct.}\meta{number}.
%    \begin{macrocode}
\newcommand*\caption@iftagfloat{%
  \caption@ifsubtype\@secondoftwo{%
    \ifx\@current@float@struct\@undefined
      \expandafter\@secondoftwo
    \else\ifx\@current@float@struct\@empty
      \expandafter\expandafter\expandafter\@secondoftwo
    \else
      \expandafter\expandafter\expandafter\@firstoftwo
    \fi\fi}}
%    \end{macrocode}
% \end{macro}
