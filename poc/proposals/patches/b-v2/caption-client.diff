+%  |\caption@client@before|\marg{type}\marg{star}\marg{optional argument}\marg{text}\par
+%  Code for the hook \texttt{caption/before}, executed inside the float (the kernel issues an
+%  error outside floats), before the counter is stepped. As in |\caption@caption| we check
+%  the group level. For |\caption*| we only set our star flag. Otherwise we decide if the
+%  counter should be stepped, as |\caption@refstepcounter| does (|\@captionstepfalse|
+%  suppresses the incrementation), and if the kernel should make a link target (see
+%  |\caption@client@settarget|), and we store the list entry in |\caption@client@list|
+%  (locally, it is used by |\caption@client@prepare|) as |\caption@dblarg| determines it:
+%  |\caption{}| gives |\relax|, so a list entry is made, |\caption[]{|\ldots|}| gives an empty
+%  one, so no list entry is made, and the option \opt{list-entry=heading} selects the caption
+%  text.
+% \changes{v3.8}{2026/10/06}{Remembers if we have told the kernel not to step the counter (PoC)}
+%  We also remember in |\caption@client@ifownnostep| whether we have told the kernel not to
+%  step the counter (see |\caption@client@nostep|): other code in this hook can do the same
+%  (e.g.~for a continued float of its own), and then our \pkg{hyperref} anchor needs a
+%  unique name (see |\caption@client@makecurrentHref|).
+%    \begin{macrocode}
+\newcommand\caption@client@before[4]{%
+  \caption@checkgrouplevel\@empty\caption
+  \IfBooleanTF{#2}%
+    {\caption@startrue}%
+    {\@nameuse{donemaincaptiontrue}% Support of the memoir document class
+     \let\caption@client@ifownnostep\@secondoftwo
+     \caption@ifrefstepcounter
+       {\caption@prepare@stepcounter{#1}\caption@client@prestep{#1}}%
+       {\caption@client@nostep}% Suppress incrementation of counter
+     \caption@client@settarget{#1}%
+     \IfNoValueTF{#3}%
+       {\caption@iftokens{#4}%
+          {\def\caption@client@list{#4}}%
+          {\def\caption@client@list{\relax}}}%
+       {\caption@iflistheading
+          {\def\caption@client@list{#4}}%
+          {\def\caption@client@list{#3}}}}}
+%    \end{macrocode}
+% \end{macro}
+%
+% \begin{macro}{\caption@client@nostep}
+% \begin{macro}{\caption@client@ifownnostep}
+% \changes{v3.8}{2026/10/06}{These macros added (PoC)}
+%  |\caption@client@nostep| tells the plug of the socket \texttt{caption/step} not to step
+%  the counter, because we have decided so (|\continuedfloat|, a caption after sub-captions
+%  placed above) or have stepped it ourselves (see |\caption@client@prestep|), and
+%  remembers this in |\caption@client@ifownnostep|\marg{true}\marg{false} (locally; it is
+%  set false by |\caption@client@before| first for every caption that is not |\caption*|,
+%  and it is only read after that, see |\caption@client@makecurrentHref|; it keeps its value
+%  until then, or until the end of the group).
+%    \begin{macrocode}
+\newcommand*\caption@client@nostep{%
+  \@captionstepfalse
+  \let\caption@client@ifownnostep\@firstoftwo}
+\let\caption@client@ifownnostep\@secondoftwo
+%    \end{macrocode}
+% \end{macro}
+% \end{macro}
+%
+% \begin{macro}{\caption@client@prestep}
+% \changes{v3.8}{2026/10/05}{This macro added (PoC)}
+%  |\caption@client@prestep|\marg{type}\par
+%  Executed by |\caption@client@before| if the counter will be stepped. It does nothing,
+%  unless the \pkg{subfig} package is loaded: its |\ContinuedFloat| decrements the float
+%  counter and sets |\if@ccflag|, and its |\caption| replaces |\refstepcounter| with
+%  |\refsteponlycounter|, which increments the counter again without resetting the
+%  sub-float counter. Since the kernel |\caption| steps the counter with the socket
+%  \texttt{caption/step} (and not with |\refstepcounter|), we use |\refsteponlycounter|
+%  here in this case and tell the plug not to step the counter. (We use the current
+%  definition of |\refsteponlycounter|, since \pkg{floatrow} makes it local when measuring
+%  the caption.)
+%    \begin{macrocode}
+\newcommand*\caption@client@prestep[1]{}
+\caption@ifclient{%
+  \caption@AtBeginDocument{%
+    \@ifpackageloaded{subfig}{%
+      \def\caption@client@prestep#1{%
+        \ifx\refstepcounter\refsteponlycounter
+          \if@ccflag
+            \refsteponlycounter{#1}%
+            \caption@client@nostep
+          \fi
+        \fi}%
+    }{}}%
+}{}
 %    \end{macrocode}
 % \end{macro}
