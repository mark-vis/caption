% \section{Fonts}
%
% The `default' fonts map to \cs{@captionfont} resp. \cs{@captionheadfont}.
%    \begin{macrocode}
\DeclareCaptionFont{ams@font}{\@captionfont}
\DeclareCaptionFont{ams@labelfont}{\@captionheadfont}
\DeclareCaptionFont{ams@textfont}{\@captionfont\upshape}
\SetCaptionDefaultFont{font}{ams@font}
\SetCaptionDefaultFont{labelfont}{ams@labelfont}
\SetCaptionDefaultFont{textfont}{ams@textfont}
%    \end{macrocode}
%
% \section{Vertical spaces before and after captions}
%
%    \begin{macrocode}
\AtCaptionPackage{%
  \setlength\belowcaptionskip{0pt}}% set to 12pt by AMS class
%    \end{macrocode}
%
% \section{Positioning}
%
%    \begin{macrocode}
\captionsetup{figureposition=b,tableposition=t}
