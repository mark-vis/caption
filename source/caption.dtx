%
% Position (default(=bottom)/bottom/top/auto)
% ONLY DEFAULT, BOTTOM AND TOP ARE DOCUMENTED!
% (I keep "auto" so I can set this to default
% if the base class is ucthesis.cls.)
%
\newcommand*\caption@setposition[1]{%
  \edef\caption@tempa{#1}%
%
  \def\caption@tempb{default}%
  \ifx\caption@tempa\caption@tempb
    \def\caption@tempa{bottom}%
  \fi
%
  \def\caption@tempb{top}%
  \ifx\caption@tempa\caption@tempb
    \let\caption@position\@firstoftwo
  \else
    \def\caption@tempb{bottom}%
    \ifx\caption@tempa\caption@tempb
      \let\caption@position\@secondoftwo
    \else
      \def\caption@tempb{auto}%
      \ifx\caption@tempa\caption@tempb
        \let\caption@position\@undefined
      \else
        \PackageError{caption}{Undefined caption position `#1'}{\caption@eh}%
      \fi
    \fi
  \fi}
