% The code of latex-lab-float that redefines \@makecaption at
% \begin{document} has the label latex-lab-testphase-float. The
% documented way for a class or package to keep its own \@makecaption
% is a voids rule (it does not warn if the code has been removed
% already): the class definition below must survive, also for \caption*.
\DocumentMetadata{lang=en}
\input{regression-test}
\documentclass{article}
\makeatletter
\long\def\@makecaption#1#2{\typeout{CLASS MAKECAPTION: \detokenize{#1}}#1. #2\par}
\AddToHook{begindocument}[myclass]{}
\DeclareHookRule{begindocument}{myclass}{voids}{latex-lab-testphase-float}
\makeatother
\begin{document}
\START
\makeatletter
\TEST{The class definition survives}{\typeout{\meaning\@makecaption}}
\makeatother
\TEST{Numbered caption and caption*}{%
  \begin{figure}[h]
    \caption{Numbered}
    \caption*{Unnumbered}
  \end{figure}}
\END
