@@ -847,6 +862,9 @@
   \ifx\@let@token\egroup\@caption@nolabel@group#1\fi
   \ifx\@let@token\check@icr\@caption@nolabel@group#1\fi
   \ifx\@let@token\maybe@ic\@caption@nolabel@drop#1\fi
