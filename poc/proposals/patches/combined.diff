+%  open and close the structure of the sub-float. The begin socket
+%  should also set \cs{@current@float@struct} (locally) to the number
+%  of this structure, so that a caption inside the sub-float uses it
+%  as parent. They have no arguments; the float type is \cs{@captype}.
+%  They should be used in vertical mode, inside the box of the sub-float
+%  (e.g., a \env{minipage}).
+%    \begin{macrocode}
+\NewTaggingSocket{subfloat/begin}{0}
