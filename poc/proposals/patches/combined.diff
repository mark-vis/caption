+% Proposal (b): \caption*, the tagging socket caption/step and the
+% subfloat sockets with tagging (and hyperref)
+\DocumentMetadata{lang=en,tagging=on}
+\input{regression-test}
+\documentclass{article}
+\usepackage{hyperref}
+\makeatletter
+% a minimal sub-caption, as a package like subcaption would do it
+\newcounter{subfigure}[figure]
+\renewcommand\thesubfigure{\alph{subfigure}}
+\def\fnum@subfigure{(\thesubfigure)}
+\def\ext@subfigure{lof}
+\def\l@subfigure{\@dottedtocline{2}{3.8em}{2.5em}}
+\newcommand\subcap[1]{%
+  \refstepcounter{subfigure}%
+  \typeout{sub target: \@currentHref}%
+  \@caption{subfigure}[#1]{#1}}
+\newcommand\showtarget{\typeout{figure=\thefigure, target=\@currentHref}}
+\makeatother
+\begin{document}
+\START
+\begin{figure}[h]
+  \caption{Numbered}\showtarget
+\end{figure}
+\begin{figure}[h]
