\newcommand*\caption@ifpackage[2]{%
  \let\next\@gobble
%
  \caption@ifpkt@caption{%
    \caption@ifbool{pkt@#1}{%
      \@ifundefined{#2}%
        {\let\next\AtBeginDocument}%
        {\let\next\@firstofone}}{}%
%
    \ifodd\caption@debug\relax
      \edef\caption@tempa{%
        \caption@ifbool{pkt@#1}{%
          \@ifundefined{#2}{AtBeginDocument}{firstofone}%
        }{gobble}}%
      \PackageInfo{caption}{#1 = \caption@ifbool{pkt@#1}{1}{0} %
	    (\@ifundefined{#2}{not }{}loaded -> \caption@tempa)}%
    \fi
  }{}%
%
  \@nameundef{caption@pkt@#1}%
  \next}
\AtEndOfPackage{\let\caption@ifpackage\@undefined}
%
% FLOAT SUPPORT
% =============
%
\caption@ifpackage{float}{float@caption}{%
  \ifx\float@caption\relax
  \else
    \PackageInfo{caption}{float package v1.2 (or newer) detected}%
%
% Note that this version of \captionof works only with float 1.3 (or newer)
% (when used with float 1.2 it simply typesets nothing)
%
    \renewcommand*\caption@of[2]{\def\@captype{#2}%
      \expandafter\let\expandafter\caption@of@float\csname @float@c@\@captype\endcsname
      #1}%
%
    \let\caption@@float\float@caption
    \long\def\float@caption#1[#2]#3{%
      \begingroup
        \caption@setfloatstyle{#1}%
        \caption@settype{#1}%
%
        \def\caption@tempa{#2}%
        \ifx\caption@tempa\@empty
          \def\addcontentsline##1##2##3{}%
        \fi
%
        \def\@fs@capt##1{%
          \caption@make
            {\@nameuse{\@ifundefined{fname@#1}{#1name}{fname@#1}}}
            {\@nameuse{the#1}}}%
        \caption@@float{#1}[{#2}]{#3}%
%
        \@ifundefined{caption@of@float}{}{%
          \def\caption@make##1##2##3{%
            \ifvoid\@floatcapt\else\unvbox\@floatcapt\fi}%
          \@makecaptionex{}{}{}%
          \global\let\caption@of@float\@undefined}%
      \endgroup}
%
    \def\caption@setfloatstyle#1{%
      \expandafter\let\expandafter\caption@fst\csname fst@#1\endcsname
      \edef\caption@fst{\noexpand\string\expandafter\noexpand\caption@fst}%
      \edef\caption@fst{\noexpand\@gobblefour\caption@fst}%
%     \edef\caption@fst{\caption@fst}%
%
      \@ifundefined{caption@sty@\caption@fst}{}{%
        \caption@setstyle\caption@fst}}%
%
% If you think this works fine, you are in a big error!
% The problem is that \newfloat and \restylefloat (of float 1.4) saves the
% *ACTUAL* definition of \@caption and \float@caption with \let (instead of
% using \def which would be much more polite to packages who redefine
% \@caption), so our own \@caption (and of course our own \float@caption)
% will never been called if the \newfloat or \restylefloat takes place in
% the preamble of the document!
%
% So we have to correct this for ourself:
% We patch \caption again, this time we determine if the user has used
% \restylefloat or \restylefloat*. This is quite easy, if \@float@c@<captype>
% is the same as the original or our own definition of \float@caption, the
% user has used \restylefloat (and \float@caption should be used), otherwise
% he has used \restylefloat* (and \@caption should be used).
% (This test only will fail if some other package re-defines \float@caption,
% too. And of course it will fail if Anselm Lingnau change this behaviour in
% his float package in the future without changing the name of the macro
% \@float@c@<captype>.)
%
    \let\caption@float\caption
    \def\caption{%
      \ifx\@captype\@undefined
        \@latex@error{\noexpand\caption outside float}\@ehd
        \expandafter\@gobble
      \else\@ifundefined{@float@c@\@captype}{}{%
%       Let's bring \@float@c@<captype> up-to-date!
        \expandafter\ifx\csname @float@c@\@captype\endcsname\float@caption
        \else\expandafter\ifx\csname @float@c@\@captype\endcsname\@caption
        \else\expandafter\ifx\csname @float@c@\@captype\endcsname\caption@@float
          \ifodd\caption@debug\relax
            \PackageInfo{caption}{\protect\@float@c@\@captype\space := \protect\float@caption}%
          \fi
          \expandafter\let\csname @float@c@\@captype\endcsname\float@caption
        \else
          \ifodd\caption@debug\relax
            \PackageInfo{caption}{\protect\@float@c@\@captype\space := \protect\@caption}%
          \fi
          \expandafter\let\csname @float@c@\@captype\endcsname\@caption
        \fi\fi\fi
      }\fi
      \caption@float}%
%
  \fi}
