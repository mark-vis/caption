+% Test of \caption* and of captions that do not step with an \@caption
+% that a class or package has replaced (as llncs or mwart), wraps (as
+% memoir or nameref) or defers (as threeparttable): the settings of
+% \fnum@<type>, \ext@<type> and \theH<type> until the next caption, the
+% number of the unique suffix given back by the kernel \@caption,
+% \@kernel@caption@reset, and \@kernel@caption@unique while the settings
+% are active.
+\input{regression-test}
+\documentclass{article}
+\makeatletter
+% the kernel definitions, for the tests that wrap or keep them
+\let\kernelcaption\caption
+\let\kernelatcaption\@caption
+% show the arguments \@makecaption gets
+\let\ORImakecaption\@makecaption
+\long\def\@makecaption#1#2{%
+  \typeout{MAKECAPTION: [\detokenize{#1}] [\detokenize{#2}],
+    star=\if@captionstar true\else false\fi}%
+  \ORImakecaption{#1}{#2}}
+% show what is written to the list
+\let\ORIaddcontentsline\addcontentsline
