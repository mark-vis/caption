% With the plugs label-only + colon the separator is
% outside Lbl; captions without label (listings titles, \caption*) must
% not get a stray separator.
\DocumentMetadata{lang=en,tagging=on}
\input{regression-test}
\documentclass{article}
\usepackage{listings}
\AssignSocketPlug{caption/label}{label-only}
\AssignSocketPlug{caption/separator}{colon}
\begin{document}
\START
\begin{lstlisting}[title={My title}]
code
\end{lstlisting}
\begin{lstlisting}[caption={My caption}]
code
\end{lstlisting}
\begin{figure}[h]
  \caption{Numbered}
\end{figure}
\begin{figure}[h]
  \caption*{Unnumbered}
\end{figure}
\SHOWPDFTAGS
\end{document}
