+% \begin{macro}{\newfloat@tagging@register}
+% \changes{v1.2a}{2026/10/03}{This macro added}
+% |\newfloat@tagging@register|\marg{environment}\par
+% With |\DocumentMetadata{tagging=on}| the tagging code of the \LaTeX\ kernel
+% (\pkg{latex-lab-testphase-float}) only knows the float types |figure| and |table|.
+% Floats of other types get a generic structure, and their captions refer to
+% structure names which do not exist, so every |\caption| gives errors.
+% Here we declare the new type with |\tagpdfsetup{float/new=|\meta{type}|}|.
+% We skip types which are already known, because older versions of
+% \pkg{latex-lab-testphase-float} (before 2026-09-09) give an error then.
+% (We do not test for a kernel declaration command by its name only:
+% \pkg{floatrowbytocbasic}, for example, defines |\DeclareFloatType|
+% with a different meaning.)
+%    \begin{macrocode}
+\newcommand*\newfloat@tagging@register[1]{%
+  \@ifpackageloaded{latex-lab-testphase-float}%
+    {\ifcsname l__tag_name_float/#1_tl\endcsname \else
+       \newfloat@Info{Registering float type `#1' for tagging}%
+       \tagpdfsetup{float/new={#1}}%
+     \fi}%
+    {}}
+\@onlypreamble\newfloat@tagging@register
+%    \end{macrocode}
+% \end{macro}
