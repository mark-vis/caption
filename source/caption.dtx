% \begin{macro}{\caption@makecaption}
% \changes{v3.1i}{2008/05/06}{Usage of \cs{caption@rule} added}
% \changes{v3.6}{2022/01/06}{Usage of \cs{caption@nobreak} added to improve \textsf{beamer} document class support}
% \changes{v3.7}{2026/10/04}{Usage of \cs{caption@tagging@begin} and \cs{caption@tagging@end} added}
%  |\@makecaption|\marg{label}\marg{text}\par
%  We do basically the same as the original code (from the standard
%  \LaTeX\ document classes), but take care of the |position=| setting
%  and use |\caption@@make| from the \pkg{caption} kernel to finally
%  typeset the caption.
%    \begin{macrocode}
\long\def\caption@makecaption#1#2{%
  \caption@nobreak
  \caption@make@above
  \caption@nobreak
  \caption@tagging@begin
  \caption@@make{#1}{#2}%
  \caption@tagging@end
  \caption@nobreak
  \caption@make@below
  \caption@nobreak}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\caption@tagging@begin}
% \begin{macro}{\caption@tagging@end}
% \changes{v3.7}{2026/10/04}{These macros added}
%  |\caption@tagging@begin|\\
%  |\caption@tagging@end|\par
%  Support of tagged PDF: The \LaTeX\ kernel declares the tagging sockets
%  \texttt{caption/begin} (with the structure number of the parent float as argument;
%  empty means the current structure) and \texttt{caption/end}.
%  When tagging is active, they get their plugs from \texttt{latex-lab}, otherwise
%  they do nothing.
%  We only use them if the kernel offers all tagging sockets we need
%  (\LaTeX\ 2026-06-01 or newer); otherwise these macros do nothing.
%    \begin{macrocode}
\newcommand*\caption@tagging@begin{}
\newcommand*\caption@tagging@end{}
\ifdefined\IfSocketExistsTF \ifdefined\NewTaggingSocketPlug
  \IfSocketExistsTF{tagsupport/caption/begin}{%
  \IfSocketExistsTF{tagsupport/parbox/before}{%
  \IfSocketExistsTF{tagsupport/para/restore}{%
%    \end{macrocode}
%  The \pkg{caption} kernel typesets the caption inside a |\parbox|. That box should
%  not be a structure of its own, and it must keep the (flattened) caption paragraph.
%  Furthermore the paragraph which |\parbox| starts outside the box is not tagged,
%  only the caption paragraph(s) inside the box.
%  Inside the |Caption| structure the \pkg{caption} kernel tags the label as |Lbl|
%  (see |\caption@iftaglbl|).
%  (These settings are local to the caption.)
%    \begin{macrocode}
    \renewcommand*\caption@tagging@begin{%
      \UseTaggingSocket{caption/begin}{\caption@floatstruct}%
      \let\caption@iftaglbl\@firstoftwo
      \AssignTaggingSocketPlug{parbox/before}{noop}%
      \AssignTaggingSocketPlug{parbox/after}{noop}%
      \ifdefined\tagpdfparaOff \tagpdfparaOff \fi
      \AssignTaggingSocketPlug{para/restore}{caption}}%
    \NewTaggingSocketPlug{para/restore}{caption}{\tagpdfparaOn}%
    \renewcommand*\caption@tagging@end{%
      \let\caption@iftaglbl\@secondoftwo
      \UseTaggingSocket{caption/end}}%
  }{}}{}}{}%
\fi \fi
%    \end{macrocode}
% \end{macro}
% \end{macro}
