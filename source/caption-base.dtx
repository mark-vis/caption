%
% \section{Implementation}
%
% The `default' caption box maps to `none`.
%    \begin{macrocode}
\SetCaptionDefaultBox{none}
%    \end{macrocode}
%
% The `default' caption format maps to `plain'.
%    \begin{macrocode}
\SetCaptionDefaultFormat{plain}
%    \end{macrocode}
%
% The `default' caption label format maps to `simple'.
%    \begin{macrocode}
\SetCaptionDefaultLabelFormat{simple}
%    \end{macrocode}
%
% The `default' caption label separator maps to `colon'.
%    \begin{macrocode}
\SetCaptionDefaultLabelSeparator{colon}
%    \end{macrocode}
%
% The `default' caption text format maps to `simple'.
%    \begin{macrocode}
\SetCaptionDefaultTextFormat{simple}
%    \end{macrocode}
%
% There is no `default' caption font, leaving the current font settings intact.
%    \begin{macrocode}
\SetCaptionDefaultFont{font}{}
\SetCaptionDefaultFont{labelfont}{}
\SetCaptionDefaultFont{textfont}{}
\SetCaptionDefaultSize{}
\SetCaptionDefaultJustification{}
%    \end{macrocode}
%
% The `default' caption list format maps to `subsimple'.
%    \begin{macrocode}
\SetCaptionDefaultListFormat{subsimple}
%    \end{macrocode}
