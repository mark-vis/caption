 %    \begin{macrocode}
-\let\caption@ifclient\@secondoftwo
+\newcommand*\caption@client{%
+  \caption@InfoNoLine{Using the caption interface of the kernel}%
+  \let\caption\@kernel@caption
+  \let\@caption\@kernel@@caption
+  \AssignSocketPlug{caption/listentry}{caption}%
