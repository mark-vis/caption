+% A caption whose label typesets nothing (here the plug noop of
+% caption/label, latex3/latex2e#2022): the label tagging sockets get the
+% plugs nolabel, as for \caption*, so there is no empty Lbl structure and
+% a caption wider than the line gets one P (before, the para hooks were
+% unbalanced: tagpdf error "para hooks differ"). A narrow caption and a
+% normal label for comparison.
+\DocumentMetadata{lang=en-GB,pdfversion=2.0,pdfstandard=ua-2,tagging=on}
+\input{regression-test}
+\documentclass{article}
+\begin{document}
+\START
+\begin{figure}
+  \AssignSocketPlug{caption/label}{noop}
+  \caption{A lonesome duck which does not have any other ducks for
+    company, but is all on her own in her own frame with only this
+    caption for company.}
+\end{figure}
+\begin{figure}
+  \AssignSocketPlug{caption/label}{noop}
+  \caption{Narrow}
+\end{figure}
+\begin{figure}
+  \caption{With label}
+\end{figure}
+\SHOWPDFTAGS
+\end{document}
