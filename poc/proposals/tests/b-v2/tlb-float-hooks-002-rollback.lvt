% Rollback of the float hooks: with latexrelease 2026-06-01
% the hooks still exist but are no longer executed.
\RequirePackage[2026-06-01]{latexrelease}
\documentclass{article}
\input{regression-test}
\AddToHookWithArguments{float/begin}{\TYPE{BEGIN: #1 [#2]}}
\AddToHookWithArguments{float/end}{\TYPE{END: #1 [#2]}}
\begin{document}
\START
\TEST{figure after rollback: no hook output}{%
  \begin{figure} A \end{figure}}
\twocolumn
\TEST{figure* after rollback: no hook output}{%
  \begin{figure*} B \end{figure*}}
\END
