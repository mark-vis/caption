diff --git a/base/testfiles/caption-outside-001.lvt b/base/testfiles/caption-outside-001.lvt
new file mode 100644
index 000000000..47324c5b7
--- /dev/null
+++ b/base/testfiles/caption-outside-001.lvt
@@ -0,0 +1,18 @@
+% \caption outside a float:
+% after the error "\caption outside float" the star, the optional and the
+% mandatory argument are skipped (before, only the next group was removed,
+% so the caption text was typeset); what follows is typeset as usual.
+\input{regression-test}
+\documentclass{article}
+\begin{document}
+\START
+\TEST{caption outside float: error, arguments skipped}{%
+  \setbox0=\vbox{\caption[Opt]{Outside}After}%
+  \showbox0 }
+\TEST{caption* outside float: error, arguments skipped}{%
+  \setbox0=\vbox{\caption*{Outside}After}%
+  \showbox0 }
+\TEST{spaces, a bracket in the optional argument}{%
+  \setbox0=\vbox{\caption [{a]b}] {Outside}After}%
+  \showbox0 }
+\END
