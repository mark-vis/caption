From 0e87703ed7bb9c91d65af5080e1c999b8dfc8315 Mon Sep 17 00:00:00 2001
From: mark-vis <118430440+mark-vis@users.noreply.github.com>
Date: Tue, 6 Oct 2026 12:30:09 +0200
Subject: [PATCH 31/32] (b) v2, part b-3: \caption* label: \vbox and \vtop also
 start the paragraph

Round-5 verification V5-3: the rule for the paragraph after the label
of \caption* (e19cf03d5) left out \vbox and \vtop, which also act
differently in vertical mode: with a class \@makecaption of the form
#1\vbox{..}#2 the box was stacked above the text (height 28.83pt instead
of 16.83pt) on the old and the new kernel. No \@makecaption of TeX Live
is known to have this. Now they start the paragraph and warn, as \hbox.

Test: caption-interface-001 TEST 30, two more shapes in vertical mode
(\vbox and \vtop after the label); on the old code both give other
heights.
---
 base/ltfloat.dtx                         | 14 ++++++++------
 base/testfiles/caption-interface-001.lvt |  4 ++++
 base/testfiles/caption-interface-001.tlg | 10 ++++++++++
 3 files changed, 22 insertions(+), 6 deletions(-)

diff --git a/base/ltfloat.dtx b/base/ltfloat.dtx
index 3bcd24f18..93aa7e3fc 100644
--- a/base/ltfloat.dtx
+++ b/base/ltfloat.dtx
@@ -820,12 +820,12 @@
 %      \cs{abovecaptionskip}).
 %    \item The rule for the paragraph: it is started before the
 %      primitives whose meaning depends on the mode (\cs{kern},
-%      \cs{penalty}, \cs{hbox}, \cs{box}, \cs{copy}, \cs{raise},
-%      \cs{lower}, \cs{vadjust}) and before \verb|\\|, \cs{newline} and
-%      \cs{@}, so that they act in horizontal mode, as after a label, and
-%      do not give an error in vertical mode. It is not started before
-%      \cs{par}, \cs{vskip}, a space or a macro (macros are not looked
-%      into). \cs{kern}, \cs{hbox}, \cs{box}, \cs{copy}, \cs{raise},
+%      \cs{penalty}, \cs{hbox}, \cs{vbox}, \cs{vtop}, \cs{box},
+%      \cs{copy}, \cs{raise}, \cs{lower}, \cs{vadjust}) and before
+%      \verb|\\|, \cs{newline} and \cs{@}, so that they act in horizontal
+%      mode, as after a label, and do not give an error in vertical mode.
+%      It is not started before \cs{par}, \cs{vskip}, a space or a macro
+%      (macros are not looked into). \cs{kern}, the boxes, \cs{raise},
 %      \cs{lower}, \verb|\\| and \cs{newline} also warn, as they print
 %      space, material or an empty line before the text; \cs{penalty},
 %      \cs{vadjust} and \cs{@} do not.
@@ -912,6 +912,8 @@
   \ifx\@let@token\penalty\let\@caption@nolabel@next\@caption@nolabel@hmode\fi
   \ifx\@let@token\kern\let\@caption@nolabel@next\@caption@nolabel@line\fi
   \ifx\@let@token\hbox\let\@caption@nolabel@next\@caption@nolabel@line\fi
+  \ifx\@let@token\vbox\let\@caption@nolabel@next\@caption@nolabel@line\fi
+  \ifx\@let@token\vtop\let\@caption@nolabel@next\@caption@nolabel@line\fi
   \ifx\@let@token\box\let\@caption@nolabel@next\@caption@nolabel@line\fi
   \ifx\@let@token\copy\let\@caption@nolabel@next\@caption@nolabel@line\fi
   \ifx\@let@token\raise\let\@caption@nolabel@next\@caption@nolabel@line\fi
diff --git a/base/testfiles/caption-interface-001.lvt b/base/testfiles/caption-interface-001.lvt
index d334461ae..568d5e0bb 100644
--- a/base/testfiles/caption-interface-001.lvt
+++ b/base/testfiles/caption-interface-001.lvt
@@ -461,6 +461,10 @@
     {\noindent\kern 3pt Text}{\nolabel\kern 3pt \ignorespaces Text}%
   \vshapeto{hbox (in the paragraph, warning)}%
     {\noindent\hbox{ -- }Text}{\nolabel\hbox{ -- }\ignorespaces Text}%
+  \vshapeto{vbox (in the paragraph, warning)}%
+    {\noindent\vbox{\hbox{ -- }}Text}{\nolabel\vbox{\hbox{ -- }}\ignorespaces Text}%
+  \vshapeto{vtop (in the paragraph, warning)}%
+    {\noindent\vtop{\hbox{ -- }}Text}{\nolabel\vtop{\hbox{ -- }}\ignorespaces Text}%
   \vshapeto{penalty (horizontal, no warning)}%
     {\noindent\penalty 7 Text}{\nolabel\penalty 7 \ignorespaces Text}}
 \TEST{kernel@caption@reset: ends the settings of caption*}{%
diff --git a/base/testfiles/caption-interface-001.tlg b/base/testfiles/caption-interface-001.tlg
index 9a09a8561..396373b74 100644
--- a/base/testfiles/caption-interface-001.tlg
+++ b/base/testfiles/caption-interface-001.tlg
@@ -589,6 +589,16 @@ LaTeX Warning: \caption* is used with a caption layout of the
                so a separator or a space may be printed before
                the text on input line ....
 VSHAPE hbox (in the paragraph, warning): as reference, warning
+LaTeX Warning: \caption* is used with a caption layout of the
+               class or of a package that does not support it,
+               so a separator or a space may be printed before
+               the text on input line ....
+VSHAPE vbox (in the paragraph, warning): as reference, warning
+LaTeX Warning: \caption* is used with a caption layout of the
+               class or of a package that does not support it,
+               so a separator or a space may be printed before
+               the text on input line ....
+VSHAPE vtop (in the paragraph, warning): as reference, warning
 VSHAPE penalty (horizontal, no warning): as reference, no warning
