% Proposal (c): contract of the caption/label socket, new caption/separator
% socket, and caption/label/begin|end used inside a paragraph
\DocumentMetadata{lang=en,tagging=on}
\input{regression-test}
\documentclass{article}
% a class-style plug as in asmeconf.cls (separator inside the plug)
\NewSocketPlug{caption/label}{class}{{\bfseries #1\quad}}
\begin{document}
\START
\begin{figure}[h]
  \caption{Kernel plugs}
\end{figure}
\begin{figure}[h]
  \AssignSocketPlug{caption/label}{label-only}%
  \AssignSocketPlug{caption/separator}{colon}%
  \caption{Separator outside Lbl}
\end{figure}
\begin{figure}[h]
  \AssignSocketPlug{caption/label}{class}%
  \caption{Class plug, unchanged}
\end{figure}
\makeatletter
\begin{figure}[h]
  % like the caption package: the label is typeset inside the caption paragraph
  \UseTaggingSocket{caption/begin}{\@current@float@struct}%
  \noindent
  \UseTaggingSocket{caption/label/begin}Figure 4\UseTaggingSocket{caption/label/end}:
  Label inside the paragraph\par
  \UseTaggingSocket{caption/end}%
\end{figure}
\makeatother
\SHOWPDFTAGS
\end{document}
