+++ b/required/firstaid/latex2e-first-aid-for-external-files.dtx
@@ -1162,6 +1162,16 @@
 %    caption without label and without list entry, and \pkg{float}'s
 %    optional argument after the caption still works, because
 %    \cs{@caption} is the last token of \cs{caption*}.
+%
+%    The kernel's settings for a replaced \cs{@caption} last until the
+%    next \cs{caption}, but here the next \cs{caption} can be the one of
+%    \pkg{float}, which does not know them. So \cs{caption} without star
+%    first undoes them (\cs{@caption@nostep@restore}) and resets
+%    \cs{if@captionstar}; otherwise a numbered caption after a
+%    \cs{caption*} in the same float would have no label, no list entry
+%    and the target name of the \cs{caption*}. (A float restyled by
+%    \pkg{float} shows only its last caption, as before: \pkg{float}
+%    keeps one caption per float.)
 %    \begin{macrocode}
 \AddToHook{package/float/after}[firstaid]{%
   \FirstAidNeededT{float}{sty}%
@@ -1169,7 +1179,10 @@
     {\ifdefined\@kernel@caption
        \let\firstaid@float@caption\caption
        \def\caption{%
-         \@ifstar\firstaid@float@starcaption\firstaid@float@caption}%
+         \@ifstar\firstaid@float@starcaption
+           {\@caption@nostep@restore
+            \@captionstarfalse
+            \firstaid@float@caption}}%
      \fi}%
 }
 %    \end{macrocode}
diff --git a/required/firstaid/testfiles/firstaid-float-caption-hyperref.lvt b/required/firstaid/testfiles/firstaid-float-caption-hyperref.lvt
new file mode 100644
index 000000000..bcb068f60
--- /dev/null
+++ b/required/firstaid/testfiles/firstaid-float-caption-hyperref.lvt
@@ -0,0 +1,40 @@
+% First aid for float with hyperref loaded before float (hyperref's
+% \@caption stays active, float's \caption replaces hyperref's): \caption*
+% gives no label, no list entry and a target with a unique name; a
+% numbered caption after it in the same float is unchanged.
+\input{regression-test}
+\documentclass{article}
+\usepackage{hyperref}
+\usepackage{float}
+\floatstyle{ruled}
+\restylefloat{table}
+\makeatletter
+\let\ORIaddcontentsline\addcontentsline
+\def\addcontentsline#1#2#3{%
+  \typeout{ADDCONTENTSLINE: {#1}{#2}{\detokenize{#3}}}%
+  \ORIaddcontentsline{#1}{#2}{#3}}
+\def\showcapt{\showbox\@floatcapt}
+\def\showstate#1{\typeout{#1=\csname the#1\endcsname,
+  label=\@currentlabel, href=\@currentHref,
+  star=\if@captionstar true\else false\fi}}
+\makeatother
+\begin{document}
+\START
+\TEST{figure: numbered, caption*, numbered}{%
+  \begin{figure}[H]
+    \caption{First}
+    \showstate{figure}
+    \caption*{Starred}
+    \showstate{figure}
+    \caption{Second}
+    \showstate{figure}
+  \end{figure}}
+\TEST{restyled table: caption*, then numbered}{%
+  \begin{table}[H]
+    \caption*{Starred table}
+    \showstate{table}
+    \caption{Numbered table}
+    \showstate{table}
+    \showcapt
+  \end{table}}
+\END
