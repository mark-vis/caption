From adcbe12d15f429d9bb8c5d88e33f8124b56fc38e Mon Sep 17 00:00:00 2001
From: Mark Vis <118430440+mark-vis@users.noreply.github.com>
Date: Mon, 5 Oct 2026 13:26:01 +0200
Subject: [PATCH 02/28] (a) doc: no \hook in a \changes entry of
 latex-lab-float

l3doc's \hook does not work in the argument of \changes, so the
documentation of latex-lab-float.dtx stopped with an error. This belongs
to (a) (squash it there).
---
 required/latex-lab/latex-lab-float.dtx | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/required/latex-lab/latex-lab-float.dtx b/required/latex-lab/latex-lab-float.dtx
index ce1b35c05..6f724b927 100644
--- a/required/latex-lab/latex-lab-float.dtx
+++ b/required/latex-lab/latex-lab-float.dtx
@@ -662,7 +662,7 @@
 %    \begin{macrocode}
         \expandafter\let\csname @floatHref@\@captype\endcsname\@currentHref
 %    \end{macrocode}
-% \changes{0.81q}{2026-10-03}{Execute the kernel hook \hook{float/begin}}
+% \changes{0.81q}{2026-10-03}{Execute the kernel hook \texttt{float/begin}}
 % Then the kernel hook \hook{float/begin}, so that code in the hook
 % is inside the float structure and after the link target.
 % (\cs{@endfloatbox} executes \hook{float/end}, so \cs{end@float}
