-% Newer kernels (PoC kernel patch (b)) offer a caption interface:
+% Newer kernels (PoC kernel patch (b), version~2) offer a caption interface:
 % \begin{itemize}
-% \item |\caption*| (no counter step, no list entry, empty label for |\@makecaption|;
-%   the legacy switch |\if@captionstar| is true while it is typeset),
-% \item the socket \texttt{caption/step} which steps the counter in |\caption|
-%   (owned by the kernel resp.\ \texttt{latex-lab}; we do not plug it),
-% \item the socket \texttt{caption/listentry} which writes the list entry in |\@caption|
-%   (we plug it),
-% \item and the generic hook \texttt{cmd/caption/before} which is executed at the
-%   start of |\caption|, before the counter is stepped.
+% \item |\caption*| (no counter step, no list entry, the label |\@caption@nolabel| for
+%   |\@makecaption|, which typesets nothing and removes the usual separators after it;
+%   the legacy switch |\if@captionstar| is true until the end of |\@caption|),
+% \item the hook \texttt{caption/before} with the arguments \meta{type}, \meta{star}
+%   (|\BooleanTrue| or |\BooleanFalse|), \meta{optional argument} (or |\NoValue|) and
+%   \meta{text}; it is executed by |\caption| after the star and the arguments have been
+%   read and before the counter is stepped, at the group level of the float,
+% \item the legacy switches |\if@captionstep| and |\if@captiontarget|, which tell the plugs
+%   of the socket \texttt{caption/step} whether the counter should be stepped and whether
+%   a link target should be made (if the counter is not stepped, the plug uses the float
+%   target or makes one with a unique name, e.g.~\texttt{figure.1*1}, never a second
+%   target with the name of the last stepped caption; we do not plug this socket),
+% \item the hook \texttt{caption/prepare} with the arguments \meta{type}, \meta{star},
+%   \meta{list text} and \meta{text}; it is executed by |\@caption| after |\par| and before
+%   the list entry, also if |\@caption| is called directly (e.g.~for sub-captions),
+% \item the socket \texttt{caption/listentry} with the arguments \meta{type},
+%   \meta{list text} and \meta{text} (we plug it),
+% \item the socket \texttt{caption/typeset} with the arguments \meta{type}, \meta{star} and
+%   \meta{text}, used by |\@caption| at the group level of the float (we plug it),
+% \item the link target of the current float of type \meta{type} in
+%   |\@floatHref@|\meta{type} (set by \texttt{latex-lab}),
+% \item and the copies |\@kernel@caption| and |\@kernel@@caption| of the kernel definitions
+%   of |\caption| and |\@caption|. They are undefined after a roll-back with
+%   \pkg{latexrelease}, so we use |\@kernel@@caption| (which comes with
+%   \texttt{caption/typeset}) as test for the interface.
 % \end{itemize}
