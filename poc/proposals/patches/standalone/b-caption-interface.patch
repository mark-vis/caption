+%
+%    The star form \cs{caption*} typesets a caption without a label:
+%    it does not step the counter, sets no target and writes no list
+%    entry. An optional argument is accepted and ignored.
+%
+%    The counter is stepped through the socket \texttt{caption/step}.
+%    Code that has to run before the step (e.g., for a continued float)
+%    can use the generic hook \hook{cmd/caption/before}.
 %    \begin{macrocode}
+%</2ekernel>
+%<*2ekernel|latexrelease>
+%<latexrelease>\IncludeInRelease{2026/11/01}%
+%<latexrelease>                 {\caption}{star form}%
 \def\caption{%
    \ifx\@captype\@undefined
      \@latex@error{\noexpand\caption outside float}\@ehd
      \expandafter\@gobble
    \else
-     \refstepcounter\@captype
      \expandafter\@firstofone
    \fi
-   {\@dblarg{\@caption\@captype}}%
+   {\@ifstar
+      {\@captionstartrue\@dblarg{\@caption\@captype}}%
+      {\@captionstarfalse
+       \UseSocket{caption/step}{\@captype}%
+       \@dblarg{\@caption\@captype}}}%
 }
+%</2ekernel|latexrelease>
+%<latexrelease>\EndIncludeInRelease
+%<latexrelease>\IncludeInRelease{0000/00/00}%
+%<latexrelease>                 {\caption}{star form}%
+%<latexrelease>\def\caption{%
+%<latexrelease>   \ifx\@captype\@undefined
+%<latexrelease>     \@latex@error{\noexpand\caption outside float}\@ehd
+%<latexrelease>     \expandafter\@gobble
+%<latexrelease>   \else
+%<latexrelease>     \refstepcounter\@captype
+%<latexrelease>     \expandafter\@firstofone
+%<latexrelease>   \fi
+%<latexrelease>   {\@dblarg{\@caption\@captype}}%
+%<latexrelease>}
+%<latexrelease>\EndIncludeInRelease
+%<*2ekernel>
 %    \end{macrocode}
 % \end{macro}
 %
