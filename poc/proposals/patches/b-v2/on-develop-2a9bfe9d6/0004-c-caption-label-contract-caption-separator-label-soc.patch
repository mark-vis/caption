+% Captions typeset by the \@makecaption of latex-lab in a box inside
+% another paragraph, as threeparttable does (it puts the table and its
+% caption into a \vtop after \noindent): an open marked content chunk of
+% the outer paragraph must not be taken as the chunk of the caption
+% paragraph. Before, the label sockets then left the para hooks
+% unbalanced (tagpdf error "para hooks differ" at the end).
+% The structure of the numbered captions and the warnings about nested
+% marked content are the same as before the caption interface (latex-lab
+% does not support a caption in a box inside a paragraph; the outer
+% paragraph contains the caption text again).
+\DocumentMetadata{lang=en,tagging=on}
+\input{regression-test}
+\documentclass{article}
+\begin{document}
+\START
+\begin{table}[h]\centering
+  \noindent\vtop{\hsize=4cm \caption{Short}\par}
+\end{table}
+\begin{table}[h]\centering
+  \noindent\vtop{\hsize=4cm \caption{A caption that is wider than the box
+    and wraps}\par}
+\end{table}
+\begin{table}[h]\centering
+  \noindent\vtop{\hsize=4cm \caption*{Starred}\par}
+\end{table}
+\SHOWPDFTAGS
+\end{document}
