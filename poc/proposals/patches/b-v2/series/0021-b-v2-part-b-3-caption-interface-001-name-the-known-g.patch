From caf73890860da6dc253e9ab5e46ccd62537e297d Mon Sep 17 00:00:00 2001
From: Mark Vis <118430440+mark-vis@users.noreply.github.com>
Date: Tue, 6 Oct 2026 06:58:52 +0200
Subject: [PATCH 21/28] (b) v2, part b-3: caption-interface-001: name the known
 gaps

Round-3 finding R3-L4 (test part). TEST 30 recorded two cases that
print a separator without a warning (a separator after a group that
contains only the label, and \relax\hskip after the label) as if they
were the intended result. They are now marked "known gap" in their
names, and a comment says that a change there can be an improvement,
not a regression. Only the two names change in the .tlg.
---
 base/testfiles/caption-interface-001.lvt | 7 +++++--
 base/testfiles/caption-interface-001.tlg | 4 ++--
 2 files changed, 7 insertions(+), 4 deletions(-)

diff --git a/base/testfiles/caption-interface-001.lvt b/base/testfiles/caption-interface-001.lvt
index 3b44e8473..a24ad0dd3 100644
--- a/base/testfiles/caption-interface-001.lvt
+++ b/base/testfiles/caption-interface-001.lvt
@@ -420,6 +420,9 @@
     \caption{Continued}
     \showhref
   \end{figure}}
+% Shapes marked "known gap" record output that is not wanted but accepted
+% (the silent cases listed in ltfloat.dtx); a change there can be an
+% improvement rather than a regression.
 \TEST{label of caption*: vertical mode, measuring, when to warn}{%
   \vshape{period, vertical mode}{\nolabel. \ignorespaces Text}%
   \vshape{label line with period and par (no empty line)}%
@@ -440,7 +443,7 @@
   \hshape{character separator (warning)}{\nolabel\ -- \ignorespaces Text}%
   \hshape{two periods (warning)}{\nolabel.. \ignorespaces Text}%
   \hshape{space in braces (warning)}{\nolabel{\hskip 1em}\ignorespaces Text}%
-  \hshape{separator after a group with the label (no warning)}%
+  \hshape{separator after a group with the label (known gap: printed, no warning)}%
     {\textit{\nolabel}\textbf{:} \ignorespaces Text}%
   \vshapeto{separator macro with a leading space (space ignored, warning)}%
     {\textendash\ Text}{\nolabel\spsep\ignorespaces Text}%
@@ -450,7 +453,7 @@
   \vshapeto{vadjust (no error)}%
     {\noindent\vadjust{\penalty 7 }Text}%
     {\nolabel\vadjust{\penalty 7 }\ignorespaces Text}%
-  \hshape{relax and hskip (printed, no warning)}%
+  \hshape{relax and hskip (known gap: printed, no warning)}%
     {\nolabel\relax\hskip 1em\ignorespaces Text}}
 \TEST{kernel@caption@reset: ends the settings of caption*}{%
   \begin{figure}
diff --git a/base/testfiles/caption-interface-001.tlg b/base/testfiles/caption-interface-001.tlg
index 569672fc7..cc5f4318c 100644
--- a/base/testfiles/caption-interface-001.tlg
+++ b/base/testfiles/caption-interface-001.tlg
@@ -562,7 +562,7 @@ LaTeX Warning: \caption* is used with a caption layout of the
                the text on input line ....
 SHAPE space in braces (warning): width 30.00005pt(text 20.00003pt)
 .... warning
-SHAPE separator after a group with the label (no warning): width 27.6389pt(text 20.00003pt)
+SHAPE separator after a group with the label (known gap: printed, no warning): width 27.6389pt(text 20.00003pt)
 .... no warning
 LaTeX Warning: \caption* is used with a caption layout of the
                class or of a package that does not support it,
@@ -576,7 +576,7 @@ LaTeX Warning: \caption* is used with a caption layout of the
 VSHAPE vskip (stays vertical, warning): as reference, warning
 VSHAPE spacefactor (no error): clean, no warning
 VSHAPE vadjust (no error): as reference, no warning
-SHAPE relax and hskip (printed, no warning): width 30.00005pt(text 20.00003pt)
+SHAPE relax and hskip (known gap: printed, no warning): width 30.00005pt(text 20.00003pt)
 .... no warning
