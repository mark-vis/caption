% Test of \@currentlabelname after captions (the title that a \label
% records for named references): the list text for \caption, also
% without any package; \caption* leaves it unchanged.
%
\input{regression-test}
\documentclass{article}
\makeatletter
\def\showname{\typeout{NAME: \expandafter\detokenize\expandafter
  {\@currentlabelname}}}
\makeatother
\begin{document}
\START
\TEST{caption, caption with optional argument, caption*}{%
  \begin{figure}
    \caption{First caption}\showname
    \caption[Short]{Long caption}\showname
    \caption*{Starred}\showname
    \caption[]{Empty list text}\showname
  \end{figure}}
\TEST{after a section (no title without packages), a table caption}{%
  \section{Heading}\showname
  \begin{table}
    \caption{Table caption}\showname
  \end{table}}
\END
