+++ b/required/firstaid/latex2e-first-aid-for-external-files.dtx
@@ -112,8 +112,8 @@
 %    \end{macrocode}
 %
 %    \begin{macrocode}
-\def\LaTeXFirstAidDate{2026-10-02}
-\def\LaTeXFirstAidVersion{v1.1z}
+\def\LaTeXFirstAidDate{2026-10-06}
